 {{if eq .Mode "pages"}}pageMode:=true{{else if eq .Mode "tokens"}}pageMode:=false{{else}}pageMode:=in.{{.Page}}!=0||in.{{.Size}}!=0{{end}}
 initial:=pagination.Cursor{}
 {{if ne .Mode "tokens"}}
 if pageMode{
  if in.{{.Page}}<0||in.{{.Size}}<0{return nil,errors.New("negative page parameters")}
  if in.{{.Page}}==0{in.{{.Page}}=1};if in.{{.Size}}==0{in.{{.Size}}={{.DefaultSize}}}
  if options.Limit>0{in.{{.Size}}=options.Limit}
  {{bounds .Operation .Page (printf "in.%s" .Page)}}
  {{bounds .Operation .Size (printf "in.%s" .Size)}}
  initial=pagination.Cursor{PageNumber:in.{{.Page}}}
 }
 {{end}}
 {{if ne .Mode "pages"}}
 if !pageMode{
  if in.{{.Limit}}<0{return nil,errors.New("negative token limit")}
  if in.{{.Limit}}==0{in.{{.Limit}}={{.DefaultSize}}};if options.Limit>0{in.{{.Limit}}=options.Limit}
  {{bounds .Operation .Limit (printf "in.%s" .Limit)}}
  initial=pagination.Cursor{Token:in.{{.Token}}}
 }
 {{end}}
 {{validate .Operation}}
 p:=&{{.Operation}}Paginator{clientOptions:append([]func(*Options){},options.ClientOptions...)}
 engine,err:=pagination.New(initial,func(ctx context.Context,cursor pagination.Cursor)(pagination.Page[*{{.Operation}}Output],error){
