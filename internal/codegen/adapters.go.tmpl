   acceptInput:=in;{{copies .Operation "acceptInput" "in"}}
   again,cause:=options.Retryable(pollContext,&acceptInput,out,err)
   if cause!=nil{decisionError=cause;return waiter.Failure};if again{return waiter.Retry}
   if err!=nil||out==nil{return waiter.Failure};return waiter.Success
  }
