  {{if ne .Mode "tokens"}}
  if pageMode{
   if out.{{.Total}}<0||out.{{.Size}}<0||(out.{{.Page}}!=0&&out.{{.Page}}!=cursor.PageNumber){return pagination.Page[*{{.Operation}}Output]{},errors.New("inconsistent page response")}
