{{range .Paginators}}
// {{.Operation}}PaginatorOptions controls page size and continuation protection.
// Constructor defaults stop duplicate tokens; callbacks must not retain options.
type {{.Operation}}PaginatorOptions struct {
 // Limit overrides the native page size when positive; zero preserves input/default.
 Limit int
 // StopOnDuplicateToken stops after returning a page with an already seen cursor.
 // Defaults to true. Explicit false may allow unbounded cyclic traversal.
 StopOnDuplicateToken bool
 // ClientOptions applies service options to every fetch; NextPage options run last.
 ClientOptions []func(*Options)
}
// {{.Operation}}Paginator traverses reviewed native pagination with one consumer.
// Input pointers/slices and option registrations are copied; do not share or copy it.
type {{.Operation}}Paginator struct {
 engine *pagination.Paginator[*{{.Operation}}Output]
 clientOptions []func(*Options)
 pendingOptions []func(*Options)
}
// New{{.Operation}}Paginator copies input and applies dedicated paginator options.
// Zero size uses the reviewed default; errors/cancellation do not advance the cursor.
func New{{.Operation}}Paginator(api {{.Operation}}API,input *{{.Operation}}Input,optFns ...func(*{{.Operation}}PaginatorOptions))(*{{.Operation}}Paginator,error){
 if api==nil{return nil,errors.New("nil paginator API")}
 options:={{.Operation}}PaginatorOptions{StopOnDuplicateToken:true}
 for _,f:=range optFns{if f==nil{return nil,errors.New("nil paginator option")};f(&options)}
 if options.Limit<0{return nil,errors.New("negative paginator limit")}
 for _,f:=range options.ClientOptions{if f==nil{return nil,errors.New("nil paginator client option")}}
 var in {{.Operation}}Input
 if input!=nil{in=*input;{{copies .Operation "in" "input"}}}
 {{if eq .Mode "pages"}}pageMode:=true{{else if eq .Mode "tokens"}}pageMode:=false{{else}}pageMode:=in.{{.Page}}!=0||in.{{.Size}}!=0{{end}}
 initial:=pagination.Cursor{}
 {{if ne .Mode "tokens"}}
 if pageMode{
  if in.{{.Page}}<0||in.{{.Size}}<0{return nil,errors.New("negative page parameters")}
  if in.{{.Page}}==0{in.{{.Page}}=1};if in.{{.Size}}==0{in.{{.Size}}={{.DefaultSize}}}
  if options.Limit>0{in.{{.Size}}=options.Limit}
  {{bounds .Operation .Page (printf "in.%s" .Page)}}
  {{bounds .Operation .Size (printf "in.%s" .Size)}}
  initial=pagination.Cursor{PageNumber:in.{{.Page}}}
 }
 {{end}}
 {{if ne .Mode "pages"}}
 if !pageMode{
  if in.{{.Limit}}<0{return nil,errors.New("negative token limit")}
  if in.{{.Limit}}==0{in.{{.Limit}}={{.DefaultSize}}};if options.Limit>0{in.{{.Limit}}=options.Limit}
  {{bounds .Operation .Limit (printf "in.%s" .Limit)}}
  initial=pagination.Cursor{Token:in.{{.Token}}}
 }
 {{end}}
 {{validate .Operation}}
 p:=&{{.Operation}}Paginator{clientOptions:append([]func(*Options){},options.ClientOptions...)}
 engine,err:=pagination.New(initial,func(ctx context.Context,cursor pagination.Cursor)(pagination.Page[*{{.Operation}}Output],error){
  request:=in;{{copies .Operation "request" "in"}}
  {{if ne .Mode "tokens"}}if pageMode{request.{{.Page}}=cursor.PageNumber}{{end}}
  {{if ne .Mode "pages"}}if !pageMode{request.{{.Token}}=cursor.Token}{{end}}
  out,err:=api.{{.Operation}}(ctx,&request,p.pendingOptions...)
  if err!=nil{return pagination.Page[*{{.Operation}}Output]{},err}
  if out==nil{return pagination.Page[*{{.Operation}}Output]{},errors.New("nil paginator response")}
  page:=pagination.Page[*{{.Operation}}Output]{Value:out}
  {{if ne .Mode "pages"}}if !pageMode{page.Next=pagination.Cursor{Token:out.{{.Token}}};page.HasMore=out.{{.Token}}!=""}{{end}}
  {{if ne .Mode "tokens"}}
  if pageMode{
   if out.{{.Total}}<0||out.{{.Size}}<0||(out.{{.Page}}!=0&&out.{{.Page}}!=cursor.PageNumber){return pagination.Page[*{{.Operation}}Output]{},errors.New("inconsistent page response")}
   size:=out.{{.Size}};if size==0{size=in.{{.Size}}}
   // Division avoids signed multiplication overflow; a next page exists only below MaxInt.
   page.HasMore=len(out.{{.Items}})>0&&out.{{.Total}}>0&&cursor.PageNumber<=(out.{{.Total}}-1)/size
   if page.HasMore{page.Next=pagination.Cursor{PageNumber:cursor.PageNumber+1}}
  }
  {{end}}
  return page,nil
 },func(o *pagination.Options){o.StopOnDuplicateCursor=options.StopOnDuplicateToken})
 if err!=nil{return nil,err};p.engine=engine;return p,nil
}
// HasMorePages reports whether another service page is available.
func(p *{{.Operation}}Paginator)HasMorePages()bool{return p.engine.HasMorePages()}
// NextPage fetches with isolated per-call options; failed/canceled calls preserve state.
// Options run after ClientOptions and do not persist into later pages.
func(p *{{.Operation}}Paginator)NextPage(ctx context.Context,optFns ...func(*Options))(*{{.Operation}}Output,error){
 for _,f:=range optFns{if f==nil{return nil,errors.New("nil page option")}}
 p.pendingOptions=append(append([]func(*Options){},p.clientOptions...),optFns...)
 defer func(){p.pendingOptions=nil}()
 return p.engine.NextPage(ctx)
}
{{end}}

{{range .Waiters}}
// {{.Name}} waits until all explicitly requested identities have the reviewed success state.
// Missing identities and reviewed retry states continue; unknown or duplicate states fail.
type {{.Name}} struct{engine *waiter.Waiter[*{{.Operation}}Output]}
// New{{.Name}} copies input/options and polls one bounded first page.
// All IDs must be nonempty and distinct; operation errors fail immediately.
func New{{.Name}}(api {{.Operation}}API,input *{{.Operation}}Input,options waiter.Options,opts ...func(*Options))(*{{.Name}},error){
 if api==nil||input==nil||len(input.{{.IDs}})==0||len(input.{{.IDs}})>{{.MaxIDs}}||input.{{.Page}}>1||input.{{.Page}}<0{return nil,errors.New("waiter requires a bounded distinct ID list on the first page")}
 in:=*input;{{copies .Operation "in" "input"}}
 in.{{.Page}}=1;in.{{.Size}}={{.MaxIDs}}
 copiedOptions:=append([]func(*Options){},opts...)
 required:=map[string]bool{}
 for _,id:=range in.{{.IDs}}{if id==""||required[id]{return nil,errors.New("invalid waiter IDs")};required[id]=true}
 engine,err:=waiter.New(func(ctx context.Context)(*{{.Operation}}Output,error){
  request:=in;{{copies .Operation "request" "in"}};return api.{{.Operation}}(ctx,&request,copiedOptions...)
 },func(out *{{.Operation}}Output,err error)waiter.Decision{
  if err!=nil||out==nil{return waiter.Failure}
  states:=map[string]string{}
  for _,entry:=range out.{{.Items}}{
   if !required[entry.{{.ID}}]{continue};if _,ok:=states[entry.{{.ID}}];ok{return waiter.Failure};states[entry.{{.ID}}]=entry.{{.State}}
  }
  success:=0
  for id:=range required{
   state,present:=states[id];if !present{continue}
   switch state{case {{q .Success}}:success++;case {{range $i,$v:=.Retry}}{{if $i}},{{end}}{{q $v}}{{end}}:;default:return waiter.Failure}
  }
  if success==len(required){return waiter.Success};return waiter.Retry
 },options)
 if err!=nil{return nil,err};return &{{.Name}}{engine:engine},nil
}
// Wait requires a positive total duration; caller context bounds each operation.
// Waiter expiry preserves waiter.ErrTimeout independently of operation retry timeouts.
func(w *{{.Name}})Wait(ctx context.Context,maxWait time.Duration)(*{{.Operation}}Output,error){return w.engine.Wait(ctx,maxWait)}
{{end}}
